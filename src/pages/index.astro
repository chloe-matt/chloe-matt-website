---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Chloe & Matt OÜ — Consulting & Contracting Entity of Asep Bagja"
  description="Chloe & Matt OÜ (Estonian registry no. 14305217) is the Tallinn-based software consultancy and B2B contracting vehicle of product and AI engineer Asep Bagja."
>
  <Nav slot="nav" />

  <!-- ============ Hero ============ -->
  <section class="hero" id="top">
    <div class="shell hero__grid">
      <div>
        <h1>The consulting &amp; contracting entity of Asep Bagja.</h1>
        <p class="hero__lede">
          Chloe &amp; Matt OÜ is a registered Estonian software company in Tallinn
          (reg.&nbsp;14305217). It serves as the B2B contracting and invoicing vehicle
          for independent engineering and AI integration work delivered personally by
          <a class="link-arrow" href="https://www.asepbagja.com" rel="noopener">Asep Bagja</a>.
        </p>
        <p class="hero__sub">
          If you saw Chloe &amp; Matt OÜ on a contract, proposal, or invoice, you are in the
          right place. All consulting inquiries, portfolio work, and writing live on Asep’s
          personal site.
        </p>
        <div class="hero__actions">
          <a
            class="btn btn--primary"
            href="https://www.asepbagja.com"
            rel="noopener"
            >Visit asepbagja.com →</a
          >
          <a
            class="btn btn--secondary"
            href="mailto:asep@chloeandmatt.eu?subject=Consulting%20enquiry"
            >Email asep@chloeandmatt.eu</a
          >
        </div>
      </div>

      <aside class="panel" id="company">
        <p class="panel__q">Corporate &amp; billing facts</p>
        <p>
          <strong>Legal name:</strong> Chloe &amp; Matt OÜ<br />
          <strong>Registry code:</strong> 14305217 (Estonian Commercial Register)<br />
          <strong>Jurisdiction:</strong> Tallinn, Republic of Estonia (EU)<br />
          <strong>Management board:</strong> Asep Bagja Priandana<br />
          <strong>Contact:</strong> <a class="link-arrow" href="mailto:asep@chloeandmatt.eu">asep@chloeandmatt.eu</a>
        </p>
        <p>
          Contracts are signed and invoiced under Estonian and EU commercial law. Every client
          engagement is scoped, engineered, and handed over directly by Asep — no account
          managers, no subcontractors, and no junior handoffs.
        </p>
      </aside>
    </div>
  </section>

  <!-- ============ Principal ============ -->
  <section class="who band" id="principal">
    <div class="shell who__grid">
      <figure class="who__photo">
        <img
          src="/images/1653680288305.jpeg"
          alt="Asep Bagja Priandana"
          width="384"
          height="384"
          loading="lazy"
        />
      </figure>

      <div class="who__prose">
        <h2>About the principal</h2>
        <p>
          <strong>Asep Bagja Priandana</strong> is a Tallinn-based product and AI engineer with
          16+ years of experience shipping production web systems, bounded AI workflows,
          desktop software, and hardware-software integrations across Europe and Southeast Asia.
        </p>
        <p>
          Alongside selective client engagements billed through Chloe &amp; Matt OÜ, he is the
          founder of <a class="link-arrow" href="https://www.nanas.ee" rel="noopener">Nanas Sound</a>
          (musical tools and hardware) and
          <a class="link-arrow" href="https://www.nanas.build" rel="noopener">nanas.build</a>
          (AI-assisted custom CAD and 3D printing).
        </p>
        <p>
          Recent client and reference builds under Chloe &amp; Matt OÜ include the multi-provider
          AI verification routing layer for Estonian KYC/KYB broker
          <a class="link-arrow" href="https://pistiik.com" rel="noopener">Pistiik OÜ ↗</a>
          and outcome-billed GDPR email verification pipelines.
        </p>
        <div class="who__links">
          <a class="link-arrow" href="https://www.asepbagja.com" rel="noopener"
            >asepbagja.com ↗</a
          >
          <a class="link-arrow" href="https://www.nanas.build" rel="noopener"
            >nanas.build ↗</a
          >
          <a class="link-arrow" href="https://www.nanas.ee" rel="noopener"
            >nanas.ee ↗</a
          >
          <a class="link-arrow" href="https://www.linkedin.com/in/asepbagja/" rel="noopener"
            >LinkedIn ↗</a
          >
          <a class="link-arrow" href="https://www.github.com/bepitulaz" rel="noopener"
            >GitHub ↗</a
          >
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
