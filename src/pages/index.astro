---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Chloe & Matt OÜ · Asep Bagja’s consulting company"
  description="Chloe & Matt OÜ (reg. 14305217) is the Tallinn-based software consulting company of engineer Asep Bagja."
>
  <Nav slot="nav" />

  <!-- ============ Hero ============ -->
  <section class="hero" id="top">
    <div class="shell hero__grid">
      <div>
        <h1>Asep Bagja’s consulting company.</h1>
        <p class="hero__lede">
          Chloe &amp; Matt OÜ is a software consulting company registered in Tallinn, Estonia
          (reg.&nbsp;14305217). It is run by <a class="link-arrow" href="https://www.asepbagja.com" rel="noopener">Asep Bagja</a>,
          who does the engineering and AI work for every client himself.
        </p>
        <p class="hero__sub">
          Found this name on a contract or proposal? You’re in the right place.
          To start a project or see past work, head to Asep’s personal site.
        </p>
        <div class="hero__actions">
          <a
            class="btn btn--primary"
            href="https://www.asepbagja.com"
            rel="noopener"
            >Visit asepbagja.com →</a
          >
          <a
            class="btn btn--secondary"
            href="mailto:asep@chloematt.eu?subject=Consulting%20enquiry"
            >Email asep@chloematt.eu</a
          >
        </div>
      </div>

      <aside class="panel" id="company">
        <p class="panel__q">Company details</p>
        <p>
          <strong>Legal name:</strong> Chloe &amp; Matt OÜ<br />
          <strong>Registry code:</strong> 14305217 (Estonian Commercial Register)<br />
          <strong>Jurisdiction:</strong> Tallinn, Republic of Estonia (EU)<br />
          <strong>Management board:</strong> Asep Bagja Priandana<br />
          <strong>Contact:</strong> <a class="link-arrow" href="mailto:asep@chloematt.eu">asep@chloematt.eu</a>
        </p>
        <p>
          Contracts and invoices follow Estonian and EU law. Asep handles every project
          himself, from the first call to the handover.
        </p>
      </aside>
    </div>
  </section>

  <!-- ============ Principal ============ -->
  <section class="who band" id="principal">
    <div class="shell who__grid">
      <figure class="who__photo">
        <img
          src="/images/1653680288305.jpeg"
          alt="Asep Bagja Priandana"
          width="384"
          height="384"
          loading="lazy"
        />
      </figure>

      <div class="who__prose">
        <h2>About Asep</h2>
        <p>
          <strong>Asep Bagja Priandana</strong> is a product and AI engineer based in Tallinn.
          He has been building software for 16+ years: web apps, AI tools, desktop apps, and
          devices that combine hardware and software. His clients are in Europe and Southeast Asia.
        </p>
        <p>
          Besides client work, he runs <a class="link-arrow" href="https://www.nanas.ee" rel="noopener">Nanas Sound</a>,
          which makes music tools and hardware, and <a class="link-arrow" href="https://www.nanas.build" rel="noopener">nanas.build</a>,
          which turns ideas into custom CAD models and 3D prints with help from AI.
        </p>
        <p>
          Recent work through Chloe &amp; Matt OÜ includes an AI system for <a class="link-arrow" href="https://pistiik.com" rel="noopener">Pistiik OÜ ↗</a>,
          an Estonian
          KYC/KYB company. It routes each identity check across several verification
          providers. He also builds GDPR-compliant email verification, billed by outcome.
        </p>
        <div class="who__links">
          <a class="link-arrow" href="https://www.asepbagja.com" rel="noopener"
            >asepbagja.com ↗</a
          >
          <a class="link-arrow" href="https://www.nanas.build" rel="noopener"
            >nanas.build ↗</a
          >
          <a class="link-arrow" href="https://www.nanas.ee" rel="noopener"
            >nanas.ee ↗</a
          >
          <a class="link-arrow" href="https://www.linkedin.com/in/asepbagja/" rel="noopener"
            >LinkedIn ↗</a
          >
          <a class="link-arrow" href="https://www.github.com/bepitulaz" rel="noopener"
            >GitHub ↗</a
          >
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
