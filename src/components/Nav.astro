<nav class="nav" aria-label="Primary">
  <a class="nav__brand" href="/">
    <img src="/images/c-m-logo.png" alt="" width="22" height="22" />
    Chloe &amp; Matt OÜ
  </a>
  <button class="nav__menu-btn" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle menu">
    <span class="nav__menu-btn-line"></span>
    <span class="nav__menu-btn-line"></span>
    <span class="nav__menu-btn-line"></span>
  </button>
  <ul class="nav__links" id="nav-menu">
    <li><a class="nav__link" href="/#principal">About Asep</a></li>
    <li><a class="nav__link" href="/#company">Company details</a></li>
    <li><a class="nav__link" href="https://www.asepbagja.com" rel="noopener">asepbagja.com ↗</a></li>
  </ul>
  <a
    class="btn btn--primary btn--sm"
    href="https://www.asepbagja.com"
    rel="noopener"
    >Work with Asep →</a
  >
</nav>

<script>
  (function () {
    var btn = document.querySelector<HTMLButtonElement>(".nav__menu-btn");
    var menu = document.getElementById("nav-menu");
    if (!btn || !menu) return;
    btn.addEventListener("click", function () {
      var open = btn!.getAttribute("aria-expanded") === "true";
      btn!.setAttribute("aria-expanded", String(!open));
      menu!.classList.toggle("is-open", !open);
    });
    menu.addEventListener("click", function (e) {
      if ((e.target as HTMLElement).tagName === "A") {
        menu!.classList.remove("is-open");
        btn!.setAttribute("aria-expanded", "false");
      }
    });
  })();
</script>
