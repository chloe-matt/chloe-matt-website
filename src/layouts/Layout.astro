---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/c-m-logo.png" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/tokens.css" />

    <script defer data-domain="chloematt.eu" src="https://plausible.io/js/script.outbound-links.js"></script>

    <style is:global>
      /* Hallmark · genre: modern-minimal · macrostructure: Split Studio
       * H2 split-diptych knobs: ratio=7/5, right=straight-answer panel, divider=negative space
       * nav: N5 Floating pill (width=content-sized, backdrop=blur+saturate, anchor=top-centred)
       * footer: Ft5 Statement (sentence=38ch, wordmark=under sentence, rule=hairline)
       * theme: custom · vibe: "honest, warm, plain-spoken, EU"
       * paper: oklch(96.5% 0.008 60) · accent: oklch(64.5% 0.206 38.4)
       * display: Bricolage Grotesque · body: Geist · outlier: Geist Mono
       * axes: light / geometric-sans / warm · enrichment: none · studied: no
       * context: user-provided (audience + tone + hosting stance), angle inferred
       * pre-emit critique: P5 H5 E4 S5 R4 V4
       *
       * contrast: pass (40–41) · nav: N5 · footer: Ft5 · slop: pass (42–45)
       * honest: pass (46) · chrome: pass (47) · tokens: pass (48)
       * responsive: pass (49) · icons: pass (30) · mobile: pass (34, 49, 50–57)
       * gate 26: no disabled state — every control is an <a>; no forms on page.
       * gate 39: N/A — no inputs.
       */

      *,
      *::before,
      *::after { box-sizing: border-box; }

      html {
        overflow-x: clip;
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
        interpolate-size: allow-keywords;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      body {
        overflow-x: clip;
        margin: 0;
        background: var(--color-paper);
        color: var(--color-ink);
        font-family: var(--font-body);
        font-size: var(--text-md);
        font-weight: 400;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        font-style: normal;
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.025em;
        overflow-wrap: anywhere;
        min-width: 0;
        margin: 0;
      }

      p { margin: 0; }
      img { max-width: 100%; height: auto; display: block; }

      a { color: inherit; }

      :focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 3px;
        border-radius: var(--space-3xs);
      }

      .shell {
        width: 100%;
        max-width: 78rem;
        margin-inline: auto;
        padding-inline: var(--page-gutter);
      }

      .tnum { font-variant-numeric: tabular-nums; }

      .vh {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .skip {
        position: absolute;
        inset-inline-start: -9999px;
        top: var(--space-md);
        z-index: var(--z-tooltip);
        background: var(--color-ink);
        color: var(--color-paper);
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-input);
        font-size: var(--text-sm);
        text-decoration: none;
      }
      .skip:focus { inset-inline-start: var(--space-md); }

      /* ============ N5 · Floating pill nav ============ */

      .nav {
        position: fixed;
        top: var(--space-md);
        left: 50%;
        transform: translateX(-50%);
        z-index: var(--z-sticky);
        display: flex;
        align-items: center;
        gap: var(--space-lg);
        max-width: calc(100% - var(--space-lg));
        padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md);
        background: color-mix(in oklch, var(--color-paper) 80%, transparent);
        backdrop-filter: blur(14px) saturate(120%);
        -webkit-backdrop-filter: blur(14px) saturate(120%);
        border: var(--rule-hair) solid var(--color-rule);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-pill);
      }

      .nav__brand {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        font-family: var(--font-display);
        font-weight: 800;
        font-size: var(--text-base);
        letter-spacing: -0.03em;
        text-decoration: none;
        white-space: nowrap;
      }
      .nav__brand img { width: 22px; height: 22px; }

      .nav__links {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
        margin: 0;
        padding: 0;
        list-style: none;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .nav__links::-webkit-scrollbar { display: none; }
      .nav__link {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-ink-2);
        text-decoration: none;
        white-space: nowrap;
        padding-block: var(--space-2xs);
        border-bottom: 2px solid transparent;
        transition: color var(--dur-short) var(--ease-out),
                    border-color var(--dur-short) var(--ease-out);
      }
      .nav__link:hover { color: var(--color-ink); border-bottom-color: var(--color-accent); }

      @media (max-width: 52rem) {
        .nav__links {
          position: absolute;
          top: calc(100% + var(--space-sm));
          left: 50%;
          transform: translateX(-50%);
          display: none;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          width: min(92vw, 18rem);
          padding: var(--space-sm);
          background: color-mix(in oklch, var(--color-paper) 92%, transparent);
          backdrop-filter: blur(14px) saturate(120%);
          -webkit-backdrop-filter: blur(14px) saturate(120%);
          border: var(--rule-hair) solid var(--color-rule);
          border-radius: var(--radius-card);
          box-shadow: var(--shadow-pill);
        }
        .nav__links.is-open { display: flex; }
        .nav__link { padding-block: var(--space-sm); }
      }
      @media (max-width: 26rem) {
        .nav { gap: var(--space-sm); padding-inline-start: var(--space-sm); }
        .nav__brand { font-size: var(--text-sm); }
      }

      /* ============ Buttons ============ */

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-xs);
        min-height: 44px;
        padding: var(--space-sm) var(--space-lg);
        font-family: var(--font-body);
        font-size: var(--text-base);
        font-weight: 500;
        white-space: nowrap;
        text-decoration: none;
        border: var(--rule-hair) solid transparent;
        border-radius: var(--radius-pill);
        cursor: pointer;
        transition: background-color var(--dur-short) var(--ease-out),
                    border-color var(--dur-short) var(--ease-out),
                    color var(--dur-short) var(--ease-out),
                    transform var(--dur-micro) var(--ease-out);
      }

      .btn--primary {
        background: var(--color-accent);
        color: var(--color-accent-ink);
      }
      .btn--secondary {
        background: transparent;
        color: var(--color-ink);
        border-color: var(--color-ink);
      }
      .btn--sm { min-height: 38px; padding: var(--space-xs) var(--space-md); font-size: var(--text-sm); }

      @media (hover: hover) and (pointer: fine) {
        .btn--primary:hover { background: var(--color-accent-deep); color: var(--color-paper); transform: translateY(-1.5px); }
        .btn--secondary:hover { background: var(--color-ink); color: var(--color-paper); transform: translateY(-1.5px); }
      }
      .btn:active { transform: translateY(1px); }

      /* ===== Mobile menu ===== */
      .nav__menu-btn {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        width: 32px;
        height: 32px;
        padding: 0;
        background: transparent;
        border: var(--rule-hair) solid transparent;
        border-radius: var(--radius-pill);
        cursor: pointer;
      }
      .nav__menu-btn-line {
        display: block;
        width: 18px;
        height: 2px;
        background: var(--color-ink);
        border-radius: 999px;
        transition: transform .2s ease, opacity .2s ease;
      }
      .nav__menu-btn[aria-expanded="true"] .nav__menu-btn-line:nth-child(1) { transform: translateY(6px) rotate(45deg); }
      .nav__menu-btn[aria-expanded="true"] .nav__menu-btn-line:nth-child(2) { opacity: 0; }
      .nav__menu-btn[aria-expanded="true"] .nav__menu-btn-line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

      @media (max-width: 52rem) {
        .nav__menu-btn { display: flex; }
        .nav .btn--sm { display: none; }
      }

      .link-arrow {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2xs);
        font-weight: 500;
        white-space: nowrap;
        color: var(--color-accent-deep);
        text-decoration: none;
        border-bottom: 1px solid var(--color-accent);
        padding-block-end: 2px;
        transition: border-color var(--dur-short) var(--ease-out);
      }
      .link-arrow:hover { border-bottom-color: var(--color-accent-deep); }

      /* ============ Section furniture ============ */

      .head-hang { max-width: 48ch; }
      .head-hang h2 {
        font-size: var(--text-3xl);
        max-width: 20ch;
        margin-block-end: var(--space-md);
      }
      .head-hang p {
        color: var(--color-ink-2);
        font-size: var(--text-md);
      }

      .band { background: var(--color-paper-2); }

      /* ============ Hero · H2 split diptych ============ */

      .hero {
        /* Bottom-heavy on purpose (gate 44a): the hero settles into the next
           section instead of floating. Top clears the fixed pill nav. */
        padding-block: calc(var(--space-2xl) + var(--space-xl)) var(--space-4xl);
      }
      .hero__grid {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        gap: var(--space-3xl);
        align-items: start;
      }
      .hero h1 {
        font-size: var(--text-display);
        font-weight: 800;
        max-width: 15ch;
        margin-block-end: var(--space-lg);
      }
      .hero__lede {
        font-size: var(--text-lg);
        line-height: 1.45;
        color: var(--color-ink-2);
        max-width: 42ch;
        margin-block-end: var(--space-md);
      }
      .hero__sub {
        color: var(--color-muted);
        max-width: 46ch;
        font-size: var(--text-base);
        margin-block-end: var(--space-xl);
      }
      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-md) var(--space-lg);
      }

      .panel {
        background: var(--color-paper-2);
        border: var(--rule-hair) solid var(--color-rule);
        border-radius: var(--radius-card);
        padding: var(--space-xl);
      }
      .panel__q {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: var(--text-lg);
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-block-end: var(--space-md);
      }
      .panel p + p { margin-block-start: var(--space-md); }
      .panel p { color: var(--color-ink-2); font-size: var(--text-base); }
      .panel strong { color: var(--color-ink); font-weight: 500; }

      @media (max-width: 60rem) {
        .hero { padding-block: calc(var(--space-2xl) + var(--space-xs)) var(--space-3xl); }
        .hero__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); }
      }

      /* ============ Packages ============ */

      .work { padding-block: var(--space-3xl); }
      .work__list {
        margin-block-start: var(--space-2xl);
        border-top: var(--rule-hair) solid var(--color-rule);
      }

      .offer {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: var(--space-lg) var(--space-2xl);
        padding-block: var(--space-xl);
        border-bottom: var(--rule-hair) solid var(--color-rule);
        transition: background-color var(--dur-short) var(--ease-out);
      }
      @media (hover: hover) and (pointer: fine) {
        .offer:hover { background: var(--color-paper-2); }
      }

      .offer__name {
        font-size: var(--text-xl);
        margin-block-end: var(--space-xs);
      }
      .offer__price {
        font-family: var(--font-outlier);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-accent-deep);
        letter-spacing: 0.02em;
      }
      .offer__body p { color: var(--color-ink-2); max-width: var(--measure); }
      .offer__for {
        margin-block-start: var(--space-md);
        font-size: var(--text-sm);
        color: var(--color-muted);
      }
      .offer__for strong { color: var(--color-ink-2); font-weight: 500; }

      .offer--audit {
        margin-block-start: var(--space-xl);
        border: var(--rule-hair) solid var(--color-rule);
        border-radius: var(--radius-card);
        background: var(--color-paper-2);
        padding: var(--space-xl);
      }

      @media (max-width: 60rem) {
        .offer { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); }
        .offer--audit { padding: var(--space-lg); }
      }

      /* ============ Worked example — diptych flipped ============ */

      .case { padding-block: var(--space-2xl) var(--space-3xl); }
      .case__grid {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: var(--space-3xl);
        align-items: start;
      }
      .case__list { margin: 0; padding: 0; list-style: none; }
      .case__list li {
        padding-block: var(--space-md);
        border-bottom: var(--rule-hair) solid var(--color-rule);
        color: var(--color-ink-2);
      }
      .case__list li:first-child { border-top: var(--rule-hair) solid var(--color-rule); }
      .case__list b { color: var(--color-ink); font-weight: 500; }

      .case__prose p { color: var(--color-ink-2); max-width: var(--measure); }
      .case__prose p + p { margin-block-start: var(--space-md); }
      .case__prose h3 {
        font-size: var(--text-xl);
        margin-block: var(--space-xl) var(--space-md);
      }

      .caveat {
        margin-block-start: var(--space-xl);
        padding-inline-start: var(--space-lg);
        border-inline-start: 2px solid var(--color-accent);
        font-size: var(--text-base);
      }

      @media (max-width: 60rem) {
        .case__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); }
      }

      /* ============ How we work ============ */

      .how { padding-block: var(--space-3xl); }
      .how__grid {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: var(--space-3xl);
        align-items: start;
      }
      .how__items {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: var(--space-xl) var(--space-2xl);
      }
      .how__items h3 {
        font-size: var(--text-md);
        margin-block-end: var(--space-2xs);
      }
      .how__items p { color: var(--color-ink-2); font-size: var(--text-base); }

      @media (max-width: 60rem) {
        .how__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); }
      }

      /* ============ About — diptych, photo left ============ */

      .who { padding-block: var(--space-3xl) var(--space-2xl); }
      .who__grid {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: var(--space-3xl);
        align-items: start;
      }
      .who__photo {
        margin: 0;
        border-radius: var(--radius-card);
        overflow: hidden;
        border: var(--rule-hair) solid var(--color-rule);
        max-width: 18rem;
      }
      .who__prose h2 { font-size: var(--text-2xl); margin-block-end: var(--space-lg); }
      .who__prose p { color: var(--color-ink-2); max-width: var(--measure); }
      .who__prose p + p { margin-block-start: var(--space-md); }
      .who__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-lg);
        margin-block-start: var(--space-xl);
      }

      @media (max-width: 60rem) {
        .who__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
        .who__photo { max-width: 12rem; }
      }

      /* ============ FAQ — single column (deliberate break) ============ */

      .faq { padding-block: var(--space-2xl) var(--space-3xl); }
      .faq__inner { max-width: 46rem; }
      .faq__list { margin-block-start: var(--space-2xl); border-top: var(--rule-hair) solid var(--color-rule); }

      .qa { border-bottom: var(--rule-hair) solid var(--color-rule); }
      .qa summary {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-lg);
        padding-block: var(--space-lg);
        cursor: pointer;
        list-style: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: var(--text-md);
        letter-spacing: -0.02em;
        transition: color var(--dur-short) var(--ease-out);
      }
      .qa summary::-webkit-details-marker { display: none; }
      .qa summary:hover { color: var(--color-accent-deep); }
      /* Body face, not the outlier — the outlier is limited to two slots
         (figures, table labels) per the 2+1 rule. */
      .qa__sign {
        flex: none;
        font-family: var(--font-body);
        font-size: var(--text-lg);
        font-weight: 400;
        color: var(--color-accent);
        line-height: 1;
        transition: transform var(--dur-short) var(--ease-in-out);
      }
      .qa[open] .qa__sign { transform: rotate(45deg); }

      .qa__a { padding-block-end: var(--space-lg); }
      .qa__a p { color: var(--color-ink-2); max-width: var(--measure); font-size: var(--text-base); }
      .qa__a p + p { margin-block-start: var(--space-md); }

      .qa::details-content {
        block-size: 0;
        overflow: hidden;
        transition: block-size var(--dur-long) var(--ease-in-out),
                    content-visibility var(--dur-long) allow-discrete;
      }
      .qa[open]::details-content { block-size: auto; }

      /* ============ Closing CTA ============ */

      .close { padding-block: var(--space-3xl); border-top: var(--rule-hair) solid var(--color-rule); }
      .close__grid {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        gap: var(--space-2xl);
        align-items: end;
      }
      .close h2 { font-size: var(--text-2xl); max-width: 20ch; margin-block-end: var(--space-md); }
      .close p { color: var(--color-ink-2); max-width: 48ch; }
      .close__actions { display: flex; flex-wrap: wrap; gap: var(--space-md); }

      @media (max-width: 60rem) {
        .close__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
      }

      /* ============ Ft5 · Statement footer ============ */

      .foot {
        background: var(--color-band);
        color: var(--color-band-ink);
        padding-block: var(--space-3xl) var(--space-xl);
      }
      .foot__line {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.75rem, 4vw + 0.5rem, 3rem);
        line-height: 1.06;
        letter-spacing: -0.03em;
        max-width: 24ch;
        overflow-wrap: anywhere;
      }
      .foot__meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-xl);
        margin-block-start: var(--space-3xl);
        padding-block-start: var(--space-lg);
        border-top: var(--rule-hair) solid var(--color-band-rule);
        font-size: var(--text-sm);
        color: var(--color-band-muted);
      }
      .foot__meta a {
        color: var(--color-band-ink);
        text-decoration: none;
        white-space: nowrap;
        border-bottom: 1px solid var(--color-band-rule);
        transition: border-color var(--dur-short) var(--ease-out);
      }
      .foot__meta a:hover { border-bottom-color: var(--color-accent); }
      .foot__links { display: flex; flex-wrap: wrap; gap: var(--space-lg); }
      .foot__ps {
        margin-block-start: var(--space-xl);
        font-size: var(--text-sm);
        color: var(--color-band-muted);
        max-width: 54ch;
      }
      .foot :focus-visible { outline-color: var(--color-accent); }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
